# Copy to backend/.env and fill in. Without GEMINI_API_KEY the app still works
# using rule-based fallbacks (chat answers from your data, rule insights, BM25 retrieval).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
# Optional: SQLite path (default: budgetit.db in the working directory)
# BUDGETIT_DB=budgetit.db
